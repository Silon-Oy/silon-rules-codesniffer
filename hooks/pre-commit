#!/bin/sh

# Silon Pre-commit Hook
# Auto-fixes and lints staged PHP files using PHPCS/PHPCBF.
# Installed by: silon-oy/silon-rules-codesniffer
# Bypass with: git commit --no-verify

# Find project root (where composer.json lives)
PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"

if [ -z "$PROJECT_ROOT" ]; then
  exit 0
fi

# Locate PHPCS/PHPCBF binaries
PHPCS="$PROJECT_ROOT/vendor/bin/phpcs"
PHPCBF="$PROJECT_ROOT/vendor/bin/phpcbf"

if [ ! -x "$PHPCS" ]; then
  echo "phpcs not found at $PHPCS — skipping pre-commit lint."
  exit 0
fi

# Determine the standard to use
if [ -f "$PROJECT_ROOT/phpcs.xml" ]; then
  STANDARD="$PROJECT_ROOT/phpcs.xml"
elif [ -f "$PROJECT_ROOT/phpcs.xml.dist" ]; then
  STANDARD="$PROJECT_ROOT/phpcs.xml.dist"
elif [ -f "$PROJECT_ROOT/.phpcs.xml" ]; then
  STANDARD="$PROJECT_ROOT/.phpcs.xml"
elif [ -f "$PROJECT_ROOT/.phpcs.xml.dist" ]; then
  STANDARD="$PROJECT_ROOT/.phpcs.xml.dist"
else
  STANDARD="Silon"
fi

# Get staged PHP files (|| true prevents exit on no matches)
STAGED_PHP_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.php' || true)

if [ -z "$STAGED_PHP_FILES" ]; then
  exit 0
fi

echo ""
echo "Silon pre-commit: auto-fixing with PHPCBF..."
echo ""

# Auto-fix staged files (phpcbf returns 1 when it fixes files, suppress)
if [ -x "$PHPCBF" ]; then
  echo "$STAGED_PHP_FILES" | xargs "$PHPCBF" --standard="$STANDARD" -q 2>/dev/null || true
  # Re-add fixed files to staging
  echo "$STAGED_PHP_FILES" | xargs git add
fi

echo "Silon pre-commit: checking with PHPCS..."
echo ""

# Run PHPCS on staged files
echo "$STAGED_PHP_FILES" | xargs "$PHPCS" --standard="$STANDARD" -s --warning-severity=0

RESULT=$?

if [ $RESULT -ne 0 ]; then
  echo ""
  echo "=========================================="
  echo "  PHPCS found errors that cannot be"
  echo "  auto-fixed. Commit BLOCKED."
  echo ""
  echo "  Fix manually, then commit again."
  echo "  Bypass: git commit --no-verify"
  echo "=========================================="
  echo ""
  exit 1
fi

echo ""
echo "PHPCS passed!"
echo ""

exit 0
