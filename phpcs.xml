<?xml version="1.0"?>
<ruleset name="Silon"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xsd">
    <description>A custom set of rules to check styles for a Silon WP projects</description>

    <file>.</file>

    <rule ref="./vendor/silon-oy/silon-rules-codesniffer/Silon/ruleset.xml"/>

    <!-- Show sniff progress and codes in all reports. -->
    <arg value="ps"/>

    <!-- Show sniff colors in all reports. -->
    <arg name="colors"/>

    <!-- All files should be UTF-8 encoded. -->
    <arg name="encoding" value="utf-8"/>

    <!-- Check PHP files only. -->
    <arg name="extensions" value="php"/>

    <arg name="parallel" value="50"/>

    <!-- PHP version check. -->
    <config name="testVersion" value="7.4-"/>
</ruleset>
